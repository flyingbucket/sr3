
{
    "name": "wavelet",
    "phase": "train", // train or val
    "gpu_ids": [
        0
    ],
    "path": { //set the path
        "log": "logs",
        "tb_logger": "tb_logger",
        "results": "results",
        "checkpoint": "checkpoint",
        "resume_state": null //pretraddin model or training state
        //"resume_state":"experiments/pre/I380000_E85"
    },
    "datasets": {
        "train": {
            "name": "whu_wavelet",
            "mode": "LRHR", // whether need LR img:HR means no LR img,LRHR means need LR img
            "dataroot": "dataset/whu_wavelet_64_512",
            "datatype": "lmdb", //lmdb or img, path of img files
            "l_resolution": 64, // low resolution need to super_resolution
            "r_resolution": 512, // high resolution
            "batch_size": 2,
            "num_workers": 4,
            "use_shuffle": true,
            "data_len": -1, // -1 represents all data used in train
            "pin_memory": true,
            "persistent_workers": true
        },
        "val": {
            "name": "whu_wavelet",
            "mode": "LRHR",
            "dataroot": "dataset/whu_wavelet_64_512",
            "datatype": "lmdb", //lmdb or img, path of img files
            "l_resolution": 64,
            "r_resolution": 512,
            "data_len": -1
        }
    },
    "model": {
        "which_model_G": "sr3", // use the ddpm or sr3 network structure
        "finetune_norm": false,
        "unet": {
            "in_channel": 5,
            "out_channel": 1,
            "inner_channel": 64,
            "norm_groups": 16,
            "channel_multiplier": [
                1,
                2,
                4,
                // 8,
                // 16
                8
                // 16
            ],
            "attn_res": [
                16
            ],
            "res_blocks": 1,
            "dropout": 0
        },
        "beta_schedule": { // use munual beta_schedule for acceleration
            "train": {
                "schedule": "linear",
                "n_timestep": 3000,
                "linear_start": 1e-6,
                "linear_end": 1e-2
            },
            "val": {
                "schedule": "linear",
                "n_timestep": 2000,
                "linear_start": 1e-6,
                "linear_end": 1e-2
            }
        },
        "diffusion": {
            "image_size": 512,
            "channels": 1, //sample channel
            "conditional": true // unconditional generation or unconditional generation(super_resolution)
        }
    },
    "train": {
        "n_iter": 1e6,
        "val_freq": 100,
        "save_checkpoint_freq": 5000,
        "print_freq": 20,
        "optimizer": {
            "type": "adam",
            "lr": 1e-4
        },
        "ema_scheduler": { // not used now
            "step_start_ema": 5000,
            "update_ema_every": 1,
            "ema_decay": 0.9999
        }
    },
    "wandb": {
        "project": "sar sr wavelet"
    },
    "enable_wandb": true ,
    "log_wandb_ckpt": true
}
